{
  "name": "md-image-path-lsp-vscode",
  "displayName": "Markdown Image Path Completion",
  "description": "Completes relative paths to image files inside Markdown ![]() links.",
  "version": "0.1.1",
  "publisher": "yuzukq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzukq/md-image-path-lsp.git",
    "directory": "clients/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[markdown]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ."
  },
  "dependencies": {
    "md-image-path-lsp": "^0.2.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.2"
  }
}
